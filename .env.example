# Скопіюй цей файл у .env і заповни. Сам .env у git НЕ потрапляє.
# ⚠️ У ЦЬОМУ ФАЙЛІ НІКОЛИ НЕ ЗБЕРІГАЙ РЕАЛЬНІ ТОКЕНИ — він комітиться в репозиторій.

# --- Telegram ---
BOT_TOKEN=                      # токен від @BotFather
OWNER_ID=                       # твій Telegram ID (@userinfobot)
ADMIN_IDS=                      # інші адміни через кому, напр. 123456789,987654321
CHANNEL_ID=                     # ID приватного каналу, напр. -1001234567890

# --- Блокчейн API ---
ETHERSCAN_API_KEY=              # etherscan.io/apis — один ключ на BSC і ETH
TRONGRID_API_KEY=               # trongrid.io
TONAPI_KEY=                     # tonconsole.com — опційно, лишай порожнім якщо TON вимкнений
SOLANA_RPC_URL=                 # helius.dev або інший RPC — опційно

# Які мережі увімкнені. Порожньо = всі, для яких є ключ і адреса гаманця.
ENABLED_NETWORKS=bsc,eth,tron

# --- Адреси гаманців (початкові, далі міняються командою /setwallet) ---
WALLET_BSC=
WALLET_ETH=
WALLET_TRON=
WALLET_TON=
WALLET_SOL=

# --- Інфраструктура ---
# Локально SQLite. На Koyeb — Postgres:
#   postgresql+asyncpg://user:pass@host/dbname?ssl=require
DATABASE_URL=sqlite+aiosqlite:///./bot.db
LOG_LEVEL=INFO                  # DEBUG тільки на розробці: логи ростуть швидко

# --- RPC-ноди для EVM-мереж (через кому) ---
# Якщо задані, використовуються замість Etherscan для цієї мережі.
# Для BSC потрібні саме публічні ноди: Etherscan не обслуговує BSC на free tier.
BSC_RPC_URLS=https://bsc-rpc.publicnode.com,https://1rpc.io/bnb,https://binance.llamarpc.com,https://bsc-dataseed.bnbchain.org,https://bsc-dataseed1.defibit.io
ETH_RPC_URLS=
